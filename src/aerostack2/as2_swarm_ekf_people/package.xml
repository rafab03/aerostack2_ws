<?xml version="1.0"?>
<package format="3">
  <name>as2_swarm_ekf_people</name>
  <version>0.0.0</version>
  <description>Distributed EKF multi-person (per global ID) consuming TrackedPersonArray.</description>

  <maintainer email="rafaelblancolopez03@gmail.com">root</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>as2_swarm_person_interfaces</exec_depend>

  <!-- numpy lo coge por pip/apt normalmente, pero no se declara en ROS -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
