<?xml version="1.0"?>
<sdf version="1.6">
  <world name="urban_medium">

    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    {% if use_origin -%}
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>{{ origin.latitude }}</latitude_deg>
      <longitude_deg>{{ origin.longitude }}</longitude_deg>
      <elevation>{{ origin.altitude }}</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>
    {% endif -%}

    <!-- Suelo SIEMPRE -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- “Urban medium” local con bloques (sin Fuel) -->
    <model name="block_1">
      <static>true</static>
      <pose>10 0 5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6 6 10</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6 6 10</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="block_2">
      <static>true</static>
      <pose>-10 0 5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6 6 10</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6 6 10</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="block_3">
      <static>true</static>
      <pose>0 12 4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>10 4 8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10 4 8</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="block_4">
      <static>true</static>
      <pose>0 -12 4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>10 4 8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10 4 8</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Actor: OJO, esto sigue tirando de Fuel -->
    <actor name="actor_walking_1">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>5 0 1.0 0 0 0</pose></waypoint>
          <waypoint><time>6</time><pose>5 5 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>12</time><pose>0 5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>18</time><pose>0 0 1.0 0 0 -1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
