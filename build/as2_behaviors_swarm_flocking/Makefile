glog: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 glog
.PHONY : glog

# fast build rule for target.
glog/fast:
	$(MAKE) $(MAKESILENT) -f _deps/glog-build/CMakeFiles/glog.dir/build.make _deps/glog-build/CMakeFiles/glog.dir/build
.PHONY : glog/fast

